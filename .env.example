APP_NAME=shopkeeper-agent-learning
APP_ENV=local

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=shopkeeper_reader
MYSQL_PASSWORD=local-reader-password
MYSQL_DATABASE=shopkeeper_dw
MYSQL_META_DATABASE=shopkeeper_meta

LLM_MODEL=deepseek-flash
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.deepseek.com

QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLUMN_COLLECTION=column_metadata
QDRANT_METRIC_COLLECTION=metric_metadata

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_VALUE_INDEX=field_values

MAX_SQL_VALIDATION_ATTEMPTS=3
QUERY_TIMEOUT_SECONDS=5

FRONTEND_ORIGIN=http://localhost:5173

HF_CACHE_PATH=C:/Users/your-name/.cache/huggingface